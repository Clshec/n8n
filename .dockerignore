# Whitelist approach: ignore everything, then allow only what Docker builds need
# This reduces build context from ~900MB to just what's required

# Ignore everything first
*

# Allow build-related files
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!tsconfig.json
!.prettierrc.js
!biome.jsonc

# Allow source packages
!packages/
!packages/**/package.json
!packages/**/dist/
!packages/**/*.ts
!packages/**/*.js
!packages/**/*.json
!packages/**/*.svg
!packages/**/*.vue
!packages/**/*.css

# Allow build scripts and patches
!scripts/
!scripts/**
!patches/
!patches/**

# Allow Docker build files (entrypoints, configs)
!docker/
!docker/images/n8n/docker-entrypoint.sh

# Specifically allow the compiled directory (if it exists)
!compiled/
!compiled/**

# Ignore node_modules
**/node_modules/
**/dist/
node_modules/
dist/
